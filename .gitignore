# Jekyll build output and cache. The Pages source is the repository root, so
# these sit at the top level. GitHub builds the site itself, so the local
# render must never be committed.
_site/
.jekyll-cache/
.jekyll-metadata

# NOTE: pages/ is deliberately NOT ignored. GitHub Pages builds from the
# committed tree and never runs generate.py, so the generated markdown has to
# be committed. Re-run `python3 generate.py` and commit the result after any
# change under artifacts/, or the published site goes stale.

# Bundler
.bundle/
vendor/
